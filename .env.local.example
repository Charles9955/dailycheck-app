# Cloud sync (optional). Copy to .env.local and fill in to enable
# Supabase-backed accounts + cross-device sync.
#
# Find these in your Supabase project: Settings → API.
# Both are safe to expose in the browser (the anon key is public by design;
# Row Level Security protects the data).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Leave both unset to run the app fully local (localStorage only, no login).
